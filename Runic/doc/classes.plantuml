@startuml
!theme toy

package Runic <<rectangle>> {
  package Core <<folder>> {
    class Main <<Artifact>> {
      {static} {abstract} CreateApplication(): unique_ptr<Application>
    }

    hide <<Artifact>> circle
    hide <<Artifact>> fields

    struct AppData {
      + name: string
      + version: string
      + identifier: string
    }

    class Application {
      - data: AppData
      - window: unique_ptr<Window>
      - systemDispatcher: EventDispatcher
      - done: bool
      + Application(const AppData&, const WindowData&)
      + getWindow(): const Window&
      + getLayerManager(): LayerManager&
      + onUpdate(): void
      + onUpdateLayers(): void
      + dispatchEvent<T>(const T&): void
      + isDone(): bool
      # addSystemEventHandler<T>(bool(const T&)): void
      # handleSystemEvent<T>(const T&): void
    }

    Main *- Application
    AppData .. (Main, Application)

    struct WindowData {
      + title: string
      + width: uint32
      + height: uint32
    }

    class Window {
      - data: WindowData
      - native: SDL_window*
      + Window(WindowData)
      + getData(): const WindowData&
      + show(): void
      + hide(): void
    }

    Application *- Window
    WindowData .. (Application, Window)

    class Log {
      {static} - CoreLogger: shared_ptr<spdlog::logger>
      {static} - ClientLogger: shared_ptr<spdlog::logger>
      {static} + Init(): void
      {static} + GetCore(): shared_ptr<spdlog::logger>&
      {static} + GetClient(): shared_ptr<spdlog::logger>&
    }

     Application -up-> Log : initializes

    class Input {
      {static} + IsKeyPressed(Key): bool
      {static} + IsMouseButtonPressed(MouseButton): bool
    }

    package Input as InputPkg {
      enum Key {
        A
        B
        C
        ...
      }

      enum MouseButton {
        Left
        Middle
        Right
        X1
        X2
      }
    }

    Input --> Key
    Input --> MouseButton

    package Event <<Frame>> {
      struct "*Event ..." as ConcreteEvent

      class EventDispatcher {
        {field} - handlers: map<type_index, vector<bool(const void*)>>
        + addHandler<T>(bool(const T&)): void
        + dispatch<T>(const T&): bool
      }
    }

    Application *-- EventDispatcher

    class Layer {
      - dispatcher: EventDispatcher
      + name: string = "Layer"
      + Layer(?name:string)
      + onAttach(): void
      + onDetach(): void
      + onUpdate(): void
      + onGuiRender(): void
      + getName(): const string&
      + addEventHandler<T>(bool(const T&)): void
      + handleEvent<T>(const T&): void
    }

    Layer *-- EventDispatcher

    class LayerManager {
      - layers: list<unique_ptr<Layer>>
      - sep: optional<list<unique_ptr<Layer>>::iterator>
      + LayerManager()
      + push_front(unique_ptr<Layer>): void
      + push_back(unique_ptr<Layer>): void
      + pop_front(): unique_ptr<Layer>
      + pop_back(): unique_ptr<Layer>
      + pushGui_front(unique_ptr<Layer>): void
      + pushGui_back(unique_ptr<Layer>): void
      + popGui_front(): unique_ptr<Layer>
      + popGui_back(): unique_ptr<Layer>
      + begin(): list<unique_ptr<Layer>>::iterator
      + end(): list<unique_ptr<Layer>>::iterator
      + rbegin(): list<unique_ptr<Layer>>::iterator
      + rend(): list<unique_ptr<Layer>>::iterator
    }

    LayerManager o-- "0..*" Layer
    Application *-- LayerManager

    LayerManager -[hidden]left- Event
    LayerManager -[hidden]right- Input
  }

  package Graphics {
    class GraphicsContext {
      - window: Window*
      - context: SDL_GLContext
      + GraphicsContext(Window*)
      + setClearColor(const vec4&): void
      + clear(): void
    }

    Application *- GraphicsContext
    GraphicsContext -> Window
  }
}

hide empty members

@enduml
